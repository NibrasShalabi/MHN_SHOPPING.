rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && request.auth.token.admin == true; }
    function isFemale() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gender == "female";
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promotions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /suppliers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /cart/{uid} { allow read, write: if isOwner(uid); }
    match /orders/{orderId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /admin_messages/{id} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }
    match /support_messages/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }
    match /ratings/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid) && !exists(/databases/$(database)/documents/ratings/$(uid));
      allow update, delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow write: if isAdmin();
    }
    match /productSuggestions/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }
    match /sharedCarts/{cartId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if false;
    }
    match /fitnessPrograms/{id} {
      allow read: if isAuth() && isFemale();
      allow write: if isAdmin();
    }
    match /fitnessProfiles/{uid} {
      allow read, write: if isOwner(uid) && isFemale();
    }
    match /order_batches/{id} { allow read, write: if isAdmin(); }
    match /loyaltyTransactions/{id} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    match /config/{id} {
      allow read: if isAuth() || id == 'loyaltyRules' || id == 'stats';
      allow write: if isAdmin();
    }
    match /sizeSets/{id} { allow read, write: if isAdmin(); }
    match /paletteColors/{id} { allow read, write: if isAdmin(); }
    match /sizeGuides/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/submissions/{submissionId} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
