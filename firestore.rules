rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && request.auth.token.admin == true; }
    function isFemale() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gender == "female";
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promotions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /suppliers/{id} { allow read: if true; allow write: if isAdmin(); }
    // ===== Loyalty =====
    // النقاط عملة: المستخدم ما بيقدر يغيّر رصيده إلا بمكافأة التقييم،
    // ومرة وحدة، وبالضبط القيمة اللي حاططها الأدمن بـ config/loyaltyRules.
    function loyaltyRules() {
      return get(/databases/$(database)/documents/config/loyaltyRules).data;
    }
    function ratingReward() {
      return loyaltyRules().get('appRatingPoints', 0);
    }
    // التقييم عم ينكتب بنفس العملية ولأول مرة
    function isFirstRating(uid) {
      return !exists(/databases/$(database)/documents/ratings/$(uid))
        && existsAfter(/databases/$(database)/documents/ratings/$(uid));
    }
    function isRatingRewardUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loyaltyPoints'])
        && loyaltyRules().get('appRatingRuleEnabled', true) == true
        && request.resource.data.loyaltyPoints == resource.data.get('loyaltyPoints', 0) + ratingReward()
        && isFirstRating(uid);
    }

    function str(v, max) { return v is string && v.size() <= max; }
    // The customer edits these fields only, once a week, with sane lengths.
    // Email, gender and points are fixed for the client.
    function isProfileEdit() {
      let d = request.resource.data;
      let last = resource.data.get('profileUpdatedAt', null);
      return d.diff(resource.data).affectedKeys().hasOnly(
               ['fullName', 'familyName', 'phone', 'secondaryPhone', 'governorate', 'area', 'profileUpdatedAt'])
        && d.profileUpdatedAt == request.time
        && (last == null || request.time > last + duration.value(7, 'd'))
        && str(d.fullName, 40) && d.fullName.size() > 0
        && str(d.familyName, 40) && d.familyName.size() > 0
        && str(d.phone, 20) && str(d.secondaryPhone, 20)
        && str(d.governorate, 40) && str(d.area, 80);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.get('loyaltyPoints', 0) == 0
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.gender in ['male', 'female']
        && !request.resource.data.keys().hasAny(['profileUpdatedAt']);
      allow update: if isAdmin() || (isOwner(uid) && (isProfileEdit() || isRatingRewardUpdate(uid)));
      allow delete: if isAdmin();
    }

    // ===== Rate limits =====
    // rateLimits/{uid}.<action> = time of the last send. Each send writes it
    // in the same batch, so the previous value says when the last one was.
    function lastSent(action) {
      let path = /databases/$(database)/documents/rateLimits/$(request.auth.uid);
      return exists(path) ? get(path).data.get(action, null) : null;
    }
    function throttled(action, minutes) {
      let last = lastSent(action);
      return getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.get(action, null) == request.time
        && (last == null || request.time > last + duration.value(minutes, 'm'));
    }
    function stampOk(changed, k) { return !(k in changed) || request.resource.data[k] == request.time; }
    match /rateLimits/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Only the server time can be written: the stamp can't be faked or reset.
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['support', 'suggestion', 'fitness'])
        && stampOk(resource == null ? request.resource.data.keys()
             : request.resource.data.diff(resource.data).affectedKeys(), 'support')
        && stampOk(resource == null ? request.resource.data.keys()
             : request.resource.data.diff(resource.data).affectedKeys(), 'suggestion')
        && stampOk(resource == null ? request.resource.data.keys()
             : request.resource.data.diff(resource.data).affectedKeys(), 'fitness');
      allow delete: if false;
    }

    match /cart/{uid} { allow read, write: if isOwner(uid); }
    match /orders/{orderId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      // الطلب بيبلش دايماً بانتظار — حالة الدفع والنقاط بيحددهن الأدمن بس
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('paymentStatus', 'pending') == 'pending'
        && !request.resource.data.keys().hasAny(['pointsDeducted', 'pointsRefunded', 'pointsAwarded', 'pointsAwardRevoked']);
      // العميل بيعيد إرسال الدفع بس بعد ما الأدمن رفضه — وبيغيّر حقول الدفع فقط
      allow update: if isAdmin() || (isAuth()
        && resource.data.userId == request.auth.uid
        && resource.data.paymentStatus == 'rejected'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['txid', 'receiptUrl', 'paymentStatus', 'paymentRejectReason', 'paymentResubmittedAt']));
      allow delete: if false;
    }
    match /admin_messages/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.type == 'broadcast' ||
        isAdmin()
      );
      allow create: if isAdmin();
      // المستخدم يعلّم رسالته الشخصية كمقروءة فقط — ما بيقدر يعدّل شي تاني
      allow update: if isAdmin() || (
        isAuth() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead == true
      );
      // الأدمن بيحذف الرسائل العامة من قسم الرسائل
      allow delete: if isAdmin();
    }
    // الـ broadcast المسكّرة لكل مستخدم — الرسالة الأصلية ما بتنلمس
    match /users/{uid}/dismissedMessages/{msgId} {
      allow read, write: if isOwner(uid);
    }
    match /support_messages/{id} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && str(request.resource.data.body, 2000)
        && throttled('support', 2);
      allow read, update, delete: if isAdmin();
    }
    match /ratings/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid) && !exists(/databases/$(database)/documents/ratings/$(uid));
      allow update, delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow write: if isAdmin();
    }
    match /productSuggestions/{id} {
      // الاقتراح بيبلش pending وباسم صاحبه — والنقاط بيعطيها الأدمن بس
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['pointsAwarded'])
        && str(request.resource.data.productName, 200) && str(request.resource.data.productLink, 500)
        && throttled('suggestion', 10);
      allow read, update, delete: if isAdmin();
    }
    match /sharedCarts/{cartId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if false;
    }
    match /fitnessPrograms/{id} {
      allow read: if isAdmin() || (isAuth() && isFemale());
      allow write: if isAdmin();
    }
    match /fitnessProfiles/{uid} {
      allow read, write: if isOwner(uid) && isFemale();
    }
    match /order_batches/{id} { allow read, write: if isAdmin(); }
    match /loyaltyTransactions/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuth()
        && id == 'rating_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.points == ratingReward()
        && isFirstRating(request.auth.uid));
      allow update, delete: if isAdmin();
    }
    match /config/{id} {
       allow read: if isAuth() || id in ['loyaltyRules', 'stats', 'catalog'];
        allow write: if isAdmin() || (isAuth() && id == 'orderCounter');
    }
    match /sizeSets/{id} { allow read, write: if isAdmin(); }
    match /paletteColors/{id} { allow read, write: if isAdmin(); }
    match /sizeGuides/{id} { allow read, write: if isAdmin(); }
    // طلبات اللياقة: الزبونة بتبعت طلبها تحت حسابها بس، بحالة "جديد"
    match /fitnessProfiles/{uid}/submissions/{submissionId} {
      allow create: if isOwner(uid) && isFemale()
        && request.resource.data.userId == uid
        && request.resource.data.status == 'new'
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 100
        && throttled('fitness', 10);
      allow read: if isOwner(uid);
    }
    // الأدمن بيقرا كل الطلبات وبيغيّر حالتها — ما حدا بيحذف بيانات صحية
    match /{path=**}/submissions/{submissionId} {
      allow read, update: if isAdmin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
        // بيانات الأدمن فقط: سعر التكلفة ورابط المصدر
        // كل TXID بيدفع طلب واحد بس — بينكتب مع الطلب بنفس الـ transaction
    match /usedTxids/{txid} {
      allow get: if isAuth();
      allow create: if isAuth()
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /productsPrivate/{id} {
          allow read, write: if isAdmin();
        }
  }
}
